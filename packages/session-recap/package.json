{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kitlangton/opencode-session-recap",
  "version": "0.1.2",
  "description": "Transient session recaps for the OpenCode V2 TUI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/opencode-plugins.git",
    "directory": "packages/session-recap"
  },
  "homepage": "https://github.com/kitlangton/opencode-plugins/tree/main/packages/session-recap",
  "bugs": "https://github.com/kitlangton/opencode-plugins/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "recap"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts .",
    "check": "bun run typecheck && bun run test",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.24 <3",
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@tsconfig/bun": "1.0.9",
    "solid-js": "1.9.12"
  }
}
