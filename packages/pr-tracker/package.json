{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kitlangton/opencode-pr-tracker",
  "version": "0.1.1",
  "description": "Session-aware pull request tracking for the OpenCode V2 TUI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/opencode-plugins.git",
    "directory": "packages/pr-tracker"
  },
  "homepage": "https://github.com/kitlangton/opencode-plugins/tree/main/packages/pr-tracker",
  "bugs": "https://github.com/kitlangton/opencode-plugins/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "github",
    "pull-request"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts .",
    "check": "bun run typecheck",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.24 <3",
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@tsconfig/bun": "1.0.9",
    "solid-js": "1.9.12"
  }
}
