{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kitlangton/opencode-pr-tracker",
  "version": "0.0.0",
  "description": "Session-aware pull request tracking for the OpenCode V2 TUI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/opencode-plugins.git",
    "directory": "packages/pr-tracker"
  },
  "homepage": "https://github.com/kitlangton/opencode-plugins/tree/main/packages/pr-tracker",
  "bugs": "https://github.com/kitlangton/opencode-plugins/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "github",
    "pull-request"
  ],
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts .",
    "check": "bun run typecheck",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17271"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@opentui/solid": "0.5.1",
    "solid-js": "1.9.14"
  }
}
